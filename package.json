{
  "name": "diffuse",
  "displayName": "Diffuse",
  "description": "Diffused light. Adjust window opacity on Linux [Wayland and X11], Windows, and macOS",
  "version": "1.3.0",
  "publisher": "krakjn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/krakjn/diffuse.git"
  },
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "opacity",
    "transparency",
    "linux",
    "wayland",
    "x11",
    "kde",
    "plasma",
    "hyprland",
    "sway",
    "gnome",
    "windows",
    "macos",
    "window"
  ],
  "galleryBanner": {
    "color": "#1e2a3a",
    "theme": "dark"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "diffuse.decreaseOpacity",
        "title": "Diffuse: Decrease Opacity"
      },
      {
        "command": "diffuse.increaseOpacity",
        "title": "Diffuse: Increase Opacity"
      },
      {
        "command": "diffuse.resetOpacity",
        "title": "Diffuse: Reset Opacity"
      },
      {
        "command": "diffuse.showEnvironment",
        "title": "Diffuse: Show Environment"
      },
      {
        "command": "diffuse.installGnomeExtension",
        "title": "Diffuse: Install GNOME Shell Extension"
      },
      {
        "command": "diffuse.enableMacosTransparency",
        "title": "Diffuse: Enable macOS Transparency"
      },
      {
        "command": "diffuse.disableMacosTransparency",
        "title": "Diffuse: Disable macOS Transparency"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "diffuse.installGnomeExtension",
          "when": "isLinux"
        },
        {
          "command": "diffuse.enableMacosTransparency",
          "when": "isMac"
        },
        {
          "command": "diffuse.disableMacosTransparency",
          "when": "isMac"
        }
      ]
    },
    "keybindings": [
      {
        "command": "diffuse.decreaseOpacity",
        "key": "ctrl+alt+z",
        "linux": "ctrl+alt+z",
        "win": "ctrl+alt+z",
        "mac": "cmd+alt+z"
      },
      {
        "command": "diffuse.increaseOpacity",
        "key": "ctrl+alt+c",
        "linux": "ctrl+alt+c",
        "win": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "diffuse.resetOpacity",
        "key": "ctrl+alt+x",
        "linux": "ctrl+alt+x",
        "win": "ctrl+alt+x",
        "mac": "cmd+alt+x"
      }
    ],
    "configuration": {
      "title": "Diffuse",
      "properties": {
        "diffuse.step": {
          "type": "number",
          "default": 0.025,
          "minimum": 0.01,
          "maximum": 1,
          "description": "Opacity change per keypress."
        },
        "diffuse.minOpacity": {
          "type": "number",
          "default": 0.25,
          "minimum": 0.05,
          "maximum": 1,
          "description": "Minimum window opacity."
        },
        "diffuse.maxOpacity": {
          "type": "number",
          "default": 1,
          "minimum": 0.05,
          "maximum": 1,
          "description": "Maximum window opacity. Reset (Ctrl+Alt+X) returns to this value."
        },
        "diffuse.backend": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "kde",
            "hyprland",
            "sway",
            "x11",
            "gnome",
            "windows",
            "macos"
          ],
          "enumDescriptions": [
            "Detect the platform and pick the best available backend.",
            "KDE Plasma Wayland via a resident KWin effect (live Effect.Opacity).",
            "Hyprland 0.55+ via hyprctl Lua set_prop.",
            "Sway via swaymsg.",
            "Any X11 session (and XWayland) via xprop _NET_WM_WINDOW_OPACITY.",
            "GNOME Wayland via the companion GNOME Shell extension.",
            "Windows via SetLayeredWindowAttributes.",
            "macOS via an opt-in patch of the editor's Electron main process."
          ],
          "description": "Opacity backend. auto probes the detected candidates in order; anything else is used without probing."
        },
        "diffuse.macosAutoRestartAfterUpdate": {
          "type": "boolean",
          "default": false,
          "description": "On macOS, automatically restart the editor after an update so the transparency patch is loaded without prompting."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node out/backends/macos/patch-content.test.js && node out/backends/macos/patcher.test.js && node out/backends/hyprland/hyprland.test.js",
    "vscode:prepublish": "npm run compile",
    "vscode:uninstall": "node ./out/uninstall.js",
    "package": "vsce package --no-dependencies --allow-missing-repository --out dist"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.4.0"
  }
}
