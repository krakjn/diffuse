{
  "name": "diffuse",
  "displayName": "Diffuse",
  "description": "Adjust editor window opacity on Linux and Windows",
  "version": "0.2.0",
  "publisher": "krakjn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/krakjn/diffuse.git"
  },
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "opacity",
    "transparency",
    "linux",
    "wayland",
    "x11",
    "kde",
    "plasma",
    "sway",
    "gnome",
    "windows",
    "window"
  ],
  "galleryBanner": {
    "color": "#1e2a3a",
    "theme": "dark"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "diffuse.decreaseOpacity",
        "title": "Diffuse: Decrease Opacity"
      },
      {
        "command": "diffuse.increaseOpacity",
        "title": "Diffuse: Increase Opacity"
      },
      {
        "command": "diffuse.resetOpacity",
        "title": "Diffuse: Reset Opacity"
      },
      {
        "command": "diffuse.showEnvironment",
        "title": "Diffuse: Show Environment"
      },
      {
        "command": "diffuse.installGnomeExtension",
        "title": "Diffuse: Install GNOME Shell Extension"
      }
    ],
    "keybindings": [
      {
        "command": "diffuse.decreaseOpacity",
        "key": "ctrl+alt+z"
      },
      {
        "command": "diffuse.increaseOpacity",
        "key": "ctrl+alt+c"
      }
    ],
    "configuration": {
      "title": "Diffuse",
      "properties": {
        "diffuse.step": {
          "type": "number",
          "default": 0.025,
          "minimum": 0.01,
          "maximum": 1,
          "description": "Opacity change per keypress."
        },
        "diffuse.minOpacity": {
          "type": "number",
          "default": 0.25,
          "minimum": 0.05,
          "maximum": 1,
          "description": "Minimum window opacity."
        },
        "diffuse.maxOpacity": {
          "type": "number",
          "default": 1,
          "minimum": 0.05,
          "maximum": 1,
          "description": "Maximum window opacity."
        },
        "diffuse.backend": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "kde",
            "sway",
            "x11",
            "gnome",
            "windows"
          ],
          "enumDescriptions": [
            "Detect the platform and pick the best available backend.",
            "KDE Plasma Wayland via ephemeral KWin scripts.",
            "Sway via swaymsg.",
            "Any X11 session (and XWayland) via xprop _NET_WM_WINDOW_OPACITY.",
            "GNOME Wayland via the companion GNOME Shell extension.",
            "Windows via SetLayeredWindowAttributes."
          ],
          "description": "Opacity backend. auto probes the detected candidates in order; anything else is used without probing."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies --allow-missing-repository --out dist"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.4.0"
  }
}
